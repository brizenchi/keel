[%- macro slug(dir) -%]
[[- 'root' if dir in ['.', './', ''] else dir | replace('./', '') | replace('/', '-') | replace('_', '-') | replace('.', '-') | lower -]]
[%- endmacro -%]
# Generated by keel (https://github.com/brizenchi/keel).
# Change directories, languages or components with `keel config` / `keel set` /
# `keel enable` rather than editing the job list; other edits survive `keel update`.
name: keel

on:
[%- if ci_mode == 'reusable' %]
  # Called from your own workflow:
  #   jobs:
  #     [[ ci_caller_job ]]:
  #       uses: ./.github/workflows/keel.yml
  workflow_call:
[%- else %]
  pull_request:
  push:
    branches: [[ '[' ]][[ default_branch ]][[ ']' ]]
[%- endif %]

permissions:
  contents: read

jobs:
[%- if 'commit-lint' in components %]
  commits:
    name: commits
    uses: brizenchi/keel/.github/workflows/pr-title.yml@v2
[%- endif %]
[%- if 'secrets' in components %]

  secrets:
    name: secrets
    uses: brizenchi/keel/.github/workflows/secrets.yml@v2
[%- endif %]
[%- if 'ci' in components and 'go' in languages %]
[%- for m in go_modules %]

  go-[[ slug(m.dir) ]]:
    name: go-[[ slug(m.dir) ]]
    uses: brizenchi/keel/.github/workflows/go.yml@v2
    with:
      working-directory: "[[ m.dir ]]"
[%- if m.packages is defined %]
      packages: "[[ m.packages ]]"
[%- endif %]
[%- if m.lint is defined %]
      lint: [[ 'true' if m.lint else 'false' ]]
[%- endif %]
[%- if m.lint_version is defined %]
      lint-version: "[[ m.lint_version ]]"
[%- endif %]
[%- endfor %]
[%- endif %]
[%- if 'ci' in components and 'node' in languages %]
[%- for p in node_projects %]

  node-[[ slug(p.dir) ]]:
    name: node-[[ slug(p.dir) ]]
    uses: brizenchi/keel/.github/workflows/node.yml@v2
    with:
      working-directory: "[[ p.dir ]]"
[%- if p.scripts is defined %]
      scripts: "[[ p.scripts ]]"
[%- endif %]
[%- if p.node_version is defined %]
      node-version: "[[ p.node_version ]]"
[%- endif %]
[%- if p.package_manager is defined %]
      package-manager: "[[ p.package_manager ]]"
[%- endif %]
[%- endfor %]
[%- endif %]
[%- if 'ci' in components and 'python' in languages %]
[%- for p in python_projects %]

  python-[[ slug(p.dir) ]]:
    name: python-[[ slug(p.dir) ]]
    uses: brizenchi/keel/.github/workflows/python.yml@v2
    with:
      working-directory: "[[ p.dir ]]"
[%- if p.python_version is defined %]
      python-version: "[[ p.python_version ]]"
[%- endif %]
[%- if p.test_command is defined %]
      test-command: "[[ p.test_command ]]"
[%- endif %]
[%- endfor %]
[%- endif %]
