[%- macro slug(dir) -%]
[[- 'root' if dir in ['.', './', ''] else dir | replace('./', '') | replace('/', '-') | replace('_', '-') | replace('.', '-') | lower -]]
[%- endmacro -%]
# Generated by dev-standards (https://github.com/brizenchi/dev-standards).
# Editable: `copier update` merges upstream changes with your edits.
# Change directories or options by re-running `uvx copier update` with new
# answers rather than editing the job list by hand.
name: standards

on:
[%- if ci_mode == 'reusable' %]
  # Called from your own workflow, e.g.:
  #   jobs:
  #     [[ ci_caller_job ]]:
  #       uses: ./.github/workflows/standards.yml
  workflow_call:
[%- else %]
  pull_request:
  push:
    branches: [[ '[' ]][[ default_branch ]][[ ']' ]]
[%- endif %]

permissions:
  contents: read

jobs:
  commits:
    name: commits
    uses: brizenchi/dev-standards/.github/workflows/pr-title.yml@v1

  secrets:
    name: secrets
    uses: brizenchi/dev-standards/.github/workflows/secrets.yml@v1
[%- if 'go' in languages %]
[%- for m in go_modules %]

  go-[[ slug(m.dir) ]]:
    name: go-[[ slug(m.dir) ]]
    uses: brizenchi/dev-standards/.github/workflows/go.yml@v1
    with:
      working-directory: "[[ m.dir ]]"
[%- if m.packages is defined %]
      packages: "[[ m.packages ]]"
[%- endif %]
[%- if m.lint is defined %]
      lint: [[ 'true' if m.lint else 'false' ]]
[%- endif %]
[%- if m.lint_version is defined %]
      lint-version: "[[ m.lint_version ]]"
[%- endif %]
[%- endfor %]
[%- endif %]
[%- if 'node' in languages %]
[%- for p in node_projects %]

  node-[[ slug(p.dir) ]]:
    name: node-[[ slug(p.dir) ]]
    uses: brizenchi/dev-standards/.github/workflows/node.yml@v1
    with:
      working-directory: "[[ p.dir ]]"
[%- if p.scripts is defined %]
      scripts: "[[ p.scripts ]]"
[%- endif %]
[%- if p.node_version is defined %]
      node-version: "[[ p.node_version ]]"
[%- endif %]
[%- if p.package_manager is defined %]
      package-manager: "[[ p.package_manager ]]"
[%- endif %]
[%- endfor %]
[%- endif %]
[%- if 'python' in languages %]
[%- for p in python_projects %]

  python-[[ slug(p.dir) ]]:
    name: python-[[ slug(p.dir) ]]
    uses: brizenchi/dev-standards/.github/workflows/python.yml@v1
    with:
      working-directory: "[[ p.dir ]]"
[%- if p.python_version is defined %]
      python-version: "[[ p.python_version ]]"
[%- endif %]
[%- if p.test_command is defined %]
      test-command: "[[ p.test_command ]]"
[%- endif %]
[%- endfor %]
[%- endif %]
