[%- macro slug(dir) -%]
[[- 'root' if dir in ['.', './', ''] else dir | replace('./', '') | replace('/', '-') | replace('_', '-') | replace('.', '-') | lower -]]
[%- endmacro -%]
[%- set p = (ci_caller_job ~ ' / ') if ci_mode == 'reusable' else '' -%]
# Status checks required before merging into [[ default_branch ]].
# Read by .standards/bin/setup-github. One check name per line, as shown on a
# pull request. Add your own workflow's checks below; vulnerability audits
# (*/ vuln, */ audit) are intentionally not required — a newly published CVE
# in a dependency must not block an unrelated fix.
[[ p ]]commits / pr-title
[[ p ]]secrets / gitleaks
[%- if 'go' in languages %]
[%- for m in go_modules %]
[[ p ]]go-[[ slug(m.dir) ]] / check
[%- if m.lint is not defined or m.lint %]
[[ p ]]go-[[ slug(m.dir) ]] / lint
[%- endif %]
[%- endfor %]
[%- endif %]
[%- if 'node' in languages %]
[%- for n in node_projects %]
[[ p ]]node-[[ slug(n.dir) ]] / check
[%- endfor %]
[%- endif %]
[%- if 'python' in languages %]
[%- for y in python_projects %]
[[ p ]]python-[[ slug(y.dir) ]] / check
[%- endfor %]
[%- endif %]
