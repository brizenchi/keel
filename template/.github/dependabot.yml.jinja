# Generated by dev-standards. Weekly grouped dependency updates.
# Docs: docs/standards/CI_QUALITY.md#依赖管理
version: 2
updates:
[%- if 'go' in languages %]
[%- for m in go_modules %]
  - package-ecosystem: gomod
    directory: "/[[ m.dir | replace('./', '') if m.dir not in ['.', './', ''] else '' ]]"
    schedule: { interval: weekly, day: monday }
    commit-message: { prefix: "build(deps)" }
    groups:
      minor-and-patch:
        update-types: [minor, patch]
[%- endfor %]
[%- endif %]
[%- if 'node' in languages %]
[%- for p in node_projects %]
  - package-ecosystem: npm
    directory: "/[[ p.dir | replace('./', '') if p.dir not in ['.', './', ''] else '' ]]"
    schedule: { interval: weekly, day: monday }
    commit-message: { prefix: "build(deps)" }
    groups:
      minor-and-patch:
        update-types: [minor, patch]
[%- endfor %]
[%- endif %]
[%- if 'python' in languages %]
[%- for p in python_projects %]
  - package-ecosystem: pip
    directory: "/[[ p.dir | replace('./', '') if p.dir not in ['.', './', ''] else '' ]]"
    schedule: { interval: weekly, day: monday }
    commit-message: { prefix: "build(deps)" }
    groups:
      minor-and-patch:
        update-types: [minor, patch]
[%- endfor %]
[%- endif %]
  - package-ecosystem: github-actions
    directory: "/"
    schedule: { interval: monthly }
    commit-message: { prefix: "ci(deps)" }
