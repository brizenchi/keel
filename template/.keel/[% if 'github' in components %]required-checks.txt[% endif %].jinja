[%- macro slug(dir) -%]
[[- 'root' if dir in ['.', './', ''] else dir | replace('./', '') | replace('/', '-') | replace('_', '-') | replace('.', '-') | lower -]]
[%- endmacro -%]
[%- set p = (ci_caller_job ~ ' / ') if ci_mode == 'reusable' else '' -%]
# Status checks required before merging into [[ default_branch ]], applied by
# `keel github`. One check name per line, exactly as shown on a pull request.
# Append your own workflow's checks below; they survive `keel update`.
# Vulnerability audits (*/ vuln, */ audit) are intentionally not required.
[%- if 'commit-lint' in components %]
[[ p ]]commits / pr-title
[%- endif %]
[%- if 'secrets' in components %]
[[ p ]]secrets / gitleaks
[%- endif %]
[%- if 'ci' in components and 'go' in languages %]
[%- for m in go_modules %]
[[ p ]]go-[[ slug(m.dir) ]] / check
[%- if m.lint is not defined or m.lint %]
[[ p ]]go-[[ slug(m.dir) ]] / lint
[%- endif %]
[%- endfor %]
[%- endif %]
[%- if 'ci' in components and 'node' in languages %]
[%- for n in node_projects %]
[[ p ]]node-[[ slug(n.dir) ]] / check
[%- endfor %]
[%- endif %]
[%- if 'ci' in components and 'python' in languages %]
[%- for y in python_projects %]
[[ p ]]python-[[ slug(y.dir) ]] / check
[%- endfor %]
[%- endif %]
