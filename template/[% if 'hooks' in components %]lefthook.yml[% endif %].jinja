# Generated by keel. Install once: `keel hooks` (needs lefthook; gitleaks recommended).
# Only checks that must run before code leaves the machine: secrets (a pushed
# secret is already leaked) and instant formatting. Everything else, including
# commit messages, is enforced by CI. Docs: docs/standards/CI_QUALITY.md

pre-commit:
  parallel: true
  commands:[% if not ('secrets' in components or languages) %] {}[% endif %]
[%- if 'secrets' in components %]
    gitleaks:
      run: |
        if command -v gitleaks >/dev/null 2>&1; then
          gitleaks git --staged --no-banner --redact --config .gitleaks.toml .
        else
          echo "gitleaks not installed — skipping local secret scan (CI still runs it)"
        fi
[%- endif %]
[%- if 'go' in languages %]
    gofmt:
      glob: "*.go"
      run: |
        out=$(gofmt -s -l {staged_files})
        if [ -n "$out" ]; then echo "gofmt needed (run: gofmt -s -w .):"; echo "$out"; exit 1; fi
[%- endif %]
[%- if 'python' in languages %]
    ruff-format:
      glob: "*.py"
      run: |
        if command -v ruff >/dev/null 2>&1; then ruff format --check {staged_files}
        elif command -v uvx >/dev/null 2>&1; then uvx ruff format --check {staged_files}
        else echo "ruff not installed — skipping (CI still checks formatting)"; fi
[%- endif %]
